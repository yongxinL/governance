{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        },
        "disabled": true
      },
      "openaiDeveloperDocs": {
        "type": "remote",
        "url": "https://developers.openai.com/mcp",
        "disabled": true
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "@playwright/mcp@<PLAYWRIGHT_MCP_VERSION>",
          "--isolated",
          "--headless"
        ],
        "disabled": true
      }
    }
  }
}
